@model IEnumerable<Proyecto1_MZ_MJ.Models.Queja>

@{
    ViewData["Title"] = "Muro de Reportes Comunitarios";
}

<style>
    .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .report-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid #eee;
        transition: transform 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .report-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .border-alta {
        border-left: 10px solid #dc3545 !important;
    }
    /* Rojo fuerte */
    .border-media {
        border-left: 10px solid #ffc107 !important;
    }
    /* Amarillo fuerte */
    .border-baja {
        border-left: 10px solid #0dcaf0 !important;
    }
    /* Azul/Cian */

    .report-img-container {
        position: relative;
        height: 200px;
        background: #f8f9fa;
    }

    .report-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ETIQUETAS FLOTANTES */
    .sector-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        z-index: 2;
    }

    .priority-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: bold;
        z-index: 2;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    .report-body {
        padding: 15px;
        flex-grow: 1;
    }

    .report-user {
        color: #4338ca;
        font-weight: bold;
        font-size: 0.8rem;
        text-transform: uppercase;
        display: block;
        margin-bottom: 5px;
    }

    .report-text {
        font-size: 1rem;
        color: #333;
        margin-bottom: 0;
    }

    .report-footer {
        padding: 12px;
        background: #f8fafc;
        border-top: 1px solid #edf2f7;
        display: flex;
        gap: 8px;
    }

    .btn-action {
        flex: 1;
        padding: 8px 4px;
        border-radius: 10px;
        text-align: center;
        font-size: 0.8rem;
        font-weight: 700;
        text-decoration: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

    .btn-view {
        background-color: #e0e7ff;
        color: #4338ca !important;
    }

    .btn-edit {
        background-color: #fef3c7;
        color: #92400e !important;
    }

    .btn-delete {
        background-color: #fee2e2;
        color: #b91c1c !important;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 id="seccion-reportes" class="fw-bold"><i class="bi bi-megaphone-fill text-primary"></i> Muro de Reportes</h2>
            <p class="text-muted">Problemáticas reportadas por los vecinos del sector.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg"></i> Nuevo Reporte
        </a>
    </div>

    <div class="report-grid">
        @foreach (var item in Model)
        {
            // Obtenemos el texto y lo limpiamos
            var textoPrioridad = (item.Prioridad ?? "Baja").ToLower();

            // Asignación de clases usando detección de palabras clave
            string claseBorde = "border-baja"; // Por defecto Azul
            string claseBadge = "bg-info text-white";

            if (textoPrioridad.Contains("alta"))
            {
                claseBorde = "border-alta";
                claseBadge = "bg-danger"; // Rojo
            }
            else if (textoPrioridad.Contains("media"))
            {
                claseBorde = "border-media";
                claseBadge = "bg-warning text-dark"; // Amarillo
            }

            <div class="report-card shadow-sm @claseBorde">
                <div class="report-img-container">
                    @if (!string.IsNullOrEmpty(item.Foto))
                    {
                        <img src="@item.Foto" class="report-img" alt="Evidencia" />
                    }
                    else
                    {
                        <div class="h-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-image text-muted display-4"></i>
                        </div>
                    }

                    @* Etiqueta de Prioridad *@
                    <span class="priority-badge @claseBadge">
                        <i class="bi bi-exclamation-triangle-fill"></i> @item.Prioridad
                    </span>

                    @* Etiqueta de Sector *@
                    <span class="sector-badge">
                        <i class="bi bi-geo-alt-fill"></i> @item.Sector
                    </span>
                </div>

                <div class="report-body">
                    <span class="report-user">Reportado por: @item.Nombre</span>
                    <p class="report-text">@item.QuejaTexto</p>
                </div>

                <div class="report-footer">
                    <a asp-action="Details" asp-route-id="@item.QuejaId" class="btn-action btn-view">
                        <i class="bi bi-eye"></i> Detalle
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.QuejaId" class="btn-action btn-edit">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.QuejaId" class="btn-action btn-delete">
                        <i class="bi bi-trash"></i> Borrar
                    </a>
                </div>
            </div>
        }
    </div>
</div>