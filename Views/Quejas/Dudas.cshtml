@{
    ViewData["Title"] = "¿Cómo subir tu evidencia?";
}

<style>
    .step-card {
        transition: all 0.3s ease;
        border-left: 4px solid #0d6efd;
    }

        .step-card:hover {
            transform: translateX(10px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .step-number {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: bold;
    }
</style>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="text-center mb-4">
                <i class="bi bi-question-circle-fill display-1 text-primary"></i>
                <h1 class="mt-3">¿Cómo subir tu evidencia?</h1>
                <p class="lead text-muted">Sigue estos sencillos pasos para reportar problemas en tu comunidad</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">

            <!-- Paso 1 -->
            <div class="card step-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4">1</div>
                        <div>
                            <h4 class="mb-2">Ve a la sección "Muro de reportes comunitarios"</h4>
                            <p class="text-muted mb-2">
                                Dirígete al menú principal y selecciona la opción de Quejas o usa el enlace directo.
                            </p>
                            <a asp-controller="Quejas" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-right-circle"></i> Ir a Reportes
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Paso 2 -->
            <div class="card step-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4">2</div>
                        <div>
                            <h4 class="mb-2">Presiona en el botón "Agregar Nuevo Reporte"</h4>
                            <p class="text-muted mb-2">
                                Encontrarás este botón en la parte superior derecha de la pantalla, con un ícono de más (+).
                            </p>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> El botón se ve así:
                                <button class="btn btn-primary btn-sm ms-2" disabled>
                                    <i class="bi bi-plus-circle"></i> Agregar Nuevo Reporte
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Paso 3 -->
            <div class="card step-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4">3</div>
                        <div>
                            <h4 class="mb-2">Ingresa tu nombre y la descripción del reporte</h4>
                            <p class="text-muted mb-2">
                                Completa los campos obligatorios: tu nombre y una descripción clara del problema.
                            </p>
                            <div class="bg-light p-3 rounded">
                                <strong>Ejemplo:</strong><br>
                                <em>Nombre:</em> Juan Pérez<br>
                                <em>Queja:</em> Fuga de agua en la tubería principal de la calle...
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Paso 4 -->
            <div class="card step-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4">4</div>
                        <div>
                            <h4 class="mb-2">En la parte de Sector, agrega la calle o una referencia</h4>
                            <p class="text-muted mb-2">
                                Indica la ubicación exacta del problema para facilitar su atención.
                            </p>
                            <div class="bg-light p-3 rounded">
                                <strong>Ejemplos de referencias:</strong><br>
                                • "Calle Principal entre 5ta y 6ta"<br>
                                • "Sector Norte, frente al parque"<br>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Paso 5 -->
            <div class="card step-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4">5</div>
                        <div>
                            <h4 class="mb-2">Toma la foto y asegúrate que se vea bien el problema</h4>
                            <p class="text-muted mb-2">
                                La foto debe ser clara y mostrar el problema de forma evidente.
                            </p>
                            <div class="alert alert-warning">
                                <i class="bi bi-camera"></i>
                                <strong>Consejos para una buena foto:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Toma la foto con buena iluminación</li>
                                    <li>Enfoca directamente el problema</li>
                                    <li>Asegúrate que la imagen sea lo mas clara posible</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Paso 6 -->
            <div class="card step-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4">6</div>
                        <div>
                            <h4 class="mb-2">Oprime el botón "Guardar"</h4>
                            <p class="text-muted mb-2">
                                Revisa que toda la información esté correcta y presiona el botón verde de Guardar.
                            </p>
                            <button class="btn btn-success" disabled>
                                <i class="bi bi-check-circle"></i> Guardar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Paso 7 -->
            <div class="card step-card mb-4 border-success">
                <div class="card-body p-4 bg-success bg-opacity-10">
                    <div class="d-flex align-items-start">
                        <div class="step-number me-4 bg-success">7</div>
                        <div>
                            <h4 class="mb-2 text-success">¡Tu reporte se ha guardado!</h4>
                            <p class="text-muted mb-2">
                                Tu reporte ha sido enviado guardado exitosamente.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Botones de acción -->
    <div class="row mt-5 mb-5">
        <div class="col-12 text-center">
            <h4 class="mb-4">¿Listo para comenzar?</h4>
            <a asp-controller="Quejas" asp-action="Create" class="btn btn-primary btn-lg me-2">
                <i class="bi bi-plus-circle"></i> Crear Reporte Ahora
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-house"></i> Volver al Inicio
            </a>
        </div>
    </div>
</div>